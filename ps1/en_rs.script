# EN 右スティック検証: 空白 = RSD、確定 = L3(en_sanity と同じ最終画面になる)
400-460:L1+CIR  # 'o'
520-580:L1+LEFT+SQ  # 'p'
640-700:UP+TRI  # 'e'
760-820:L1+TRI  # 'n'
880-888:RSD  # 右スティック↓ = 空白
1000-1060:L1+SQ  # 'm'
1120-1180:LEFT+SQ  # 'a'
1240-1300:RIGHT+CIR  # 'i'
1360-1420:DOWN+CIR  # 'l'
1480-1540:LEFT+TRI  # 'b'
1600-1660:L1+CIR  # 'o'
1720-1780:L1+RIGHT+TRI  # 'x'
1840-1900:L3  # L3 押込み = 確定
