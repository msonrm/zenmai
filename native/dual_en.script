# 統合版 EN: メニューで ↓ → Start → en_rs 本体
100-130:START           # ★言語メニュー: 既定が ENGLISH になったので ↓ は要らない
400-460:L1+CIR  # 'o'
520-580:L1+LEFT+SQ  # 'p'
640-700:UP+TRI  # 'e'
760-820:L1+TRI  # 'n'
880-940:X  # × (方向キーなし) = 空白
1000-1060:L1+SQ  # 'm'
1120-1180:LEFT+SQ  # 'a'
1240-1300:RIGHT+CIR  # 'i'
1360-1420:DOWN+CIR  # 'l'
1480-1540:LEFT+TRI  # 'b'
1600-1660:L1+CIR  # 'o'
1720-1780:L1+RIGHT+TRI  # 'x'
1840-1900:L3  # L3 押込み = 確定
